# ============================================================
# 讀取 jobs/ 資料夾
# 每個 job = 一個 .json（設定）+ 同名 .txt（prompt）
# active: true → 執行 / active: false → 跳過
# ============================================================

def make_jobs():
    jobs_dir   = os.path.join(os.path.dirname(os.path.abspath(__file__)), "jobs")
    json_files = sorted(glob.glob(os.path.join(jobs_dir, "*.json")))

    if not json_files:
        print("❌ 喺 jobs/ 資料夾搵唔到任何 .json 檔案！")
        return []

    jobs = []
    for path in json_files:
        with open(path, "r", encoding="utf-8") as f:
            job = json.load(f)

        # 跳過 inactive job
        if not job.get("active", True):
            print(f"⏭️  跳過（inactive）: {job.get('name', path)}")
            continue

        # 讀同名 .txt 作為 prompt
        txt_path = path.replace(".json", ".txt")
        if os.path.exists(txt_path):
            with open(txt_path, "r", encoding="utf-8") as ft:
                prompt = ft.read()
        else:
            prompt = job.get("prompt", "")

        # 替換 {KEY} → "Image N" 或 "Video N"
        selected  = job.get("selected", [])
        img_count = 0
        vid_count = 0
        tag       = {}
        for key in selected:
            url = ASSETS.get(key, "")
            if url.lower().split("?")[0].endswith((".mp4", ".mov", ".webm")):
                vid_count += 1
                tag[key] = f"Video {vid_count}"
            else:
                img_count += 1
                tag[key] = f"Image {img_count}"
        for key, label in tag.items():
            prompt = prompt.replace(f"{{{key}}}", label)

        # 替換 {AUDIO}
        audio_key = job.get("audio", "")
        if audio_key and audio_key in AUDIO_DESCS:
            prompt = prompt.replace("{AUDIO}", AUDIO_DESCS[audio_key])
        else:
            prompt = prompt.replace("{AUDIO}", "")

        job["prompt"] = prompt
        jobs.append(job)
        print(f"✅ 載入: {job['name']}  ratio={job.get('ratio','9:16')}  {job.get('duration')}s  {job.get('resolution')}  mode={job.get('mode','REFERENCE')}")

    return jobs

