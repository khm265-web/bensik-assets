def build_content(job):
    selected = job["selected"]
    mode     = job["mode"]
    prompt   = job["prompt"]

    content = [{"type": "text", "text": prompt.strip()}]

    for key in selected:
        url = ASSETS[key]
        if url.lower().split("?")[0].endswith((".mp4", ".mov", ".webm")):
            content.append({
                "type":      "video_url",
                "video_url": {"url": url},
                "role":      "reference_video"
            })
        else:
            content.append({
                "type":      "image_url",
                "image_url": {"url": url},
                "role":      "reference_image"
            })

    # 額外 ref_videos（獨立 URL，唔係 ASSETS key）
    for url in job.get("ref_videos", []):
        content.append({
            "type":      "video_url",
            "video_url": {"url": url},
            "role":      "reference_video"
        })

    if mode == "FIRSTFRAME":
        content.append({
            "type":      "image_url",
            "image_url": {"url": ASSETS["FIRSTFRAME"]},
            "role":      "first_frame"
        })
    elif mode == "LASTFRAME":
        content.append({
            "type":      "image_url",
            "image_url": {"url": ASSETS["LASTFRAME"]},
            "role":      "last_frame"
        })
    elif mode == "FIRSTLAST":
        content.append({
            "type":      "image_url",
            "image_url": {"url": ASSETS["FIRSTFRAME"]},
            "role":      "first_frame"
        })
        content.append({
            "type":      "image_url",
            "image_url": {"url": ASSETS["LASTFRAME"]},
            "role":      "last_frame"
        })

    return content


def create_task(job, content):
    payload = {
        "model":          MODEL_ID,
        "content":        content,
        "ratio":          job.get("ratio", "9:16"),
        "resolution":     job["resolution"],
        "duration":       job["duration"],
        "generate_audio": True,
        **({"seed":            job["seed"]}             if "seed"            in job else {}),
        **({"negative_prompt": job["negative_prompt"]}  if "negative_prompt" in job else {}),
    }

    for attempt in range(1, 4):
        try:
            response = requests.post(
                f"{BASE_URL}/contents/generations/tasks",
                headers={
                    "Authorization": f"Bearer {API_KEY}",
                    "Content-Type":  "application/json",
                },
                data=json.dumps(payload, ensure_ascii=False).encode("utf-8"),
                timeout=120
            )

            if response.status_code != 200:
                print(f"[{job['name']}] ❌ 提交失敗 {response.status_code}: {response.text}")
                return None

            result  = response.json()
            task_id = result.get("id")
            print(f"[{job['name']}] ✅ 提交成功 Task ID: {task_id}")
            return task_id

        except requests.exceptions.Timeout:
            print(f"[{job['name']}] ⏱️ Timeout，重試 {attempt}/3...")
            time.sleep(10)

    print(f"[{job['name']}] ❌ 重試 3 次後仍然失敗")
    return None


def poll_and_download(job, task_id):
    name          = job["name"]
    poll_interval = 15

    while True:
        time.sleep(poll_interval)

        response = requests.get(
            f"{BASE_URL}/contents/generations/tasks/{task_id}",
            headers={"Authorization": f"Bearer {API_KEY}"},
            timeout=30
        )

        if response.status_code != 200:
            print(f"[{name}] ❌ 查詢失敗 {response.status_code}: {response.text}")
            return

        result = response.json()
        status = result.get("status")
        print(f"[{name}] 狀態: {status}")

        if status == "succeeded":
            video_url = result["content"]["video_url"]
            break
        elif status in ("failed", "cancelled"):
            print(f"[{name}] ❌ 任務失敗: {result}")
            return

    print(f"[{name}] 📥 下載中...")
    dl = requests.get(video_url, timeout=300)
    if dl.status_code != 200:
        print(f"[{name}] ❌ 下載失敗")
        return

    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    filename  = f"{name}_{timestamp}.mp4"
    with open(filename, "wb") as f:
        f.write(dl.content)

    size_mb = os.path.getsize(filename) / 1024 / 1024
    print(f"[{name}] ✅ 完成！儲存為：{filename}（{size_mb:.1f} MB）")


def run_job(job):
    content = build_content(job)
    task_id = create_task(job, content)
    if not task_id:
        return
    poll_and_download(job, task_id)


def generate():
    print("📂 載入 jobs...\n")
    jobs = make_jobs()

    if not jobs:
        print("⚠️  沒有 active job，結束。")
        return

    print(f"\n🚀 共 {len(jobs)} 個 active JOB，最多 {MAX_WORKERS} 個同時進行\n")

    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
        futures = {executor.submit(run_job, job): job["name"] for job in jobs}
        for future in as_completed(futures):
            name = futures[future]
            try:
                future.result()
            except Exception as e:
                print(f"[{name}] ❌ 例外錯誤: {e}")

    print("\n🎬 所有 JOB 完成！")

    import winsound
    for _ in range(3):
        winsound.Beep(1000, 500)


if __name__ == "__main__":
    generate()
